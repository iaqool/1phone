# Copy to .env.local and fill locally. Never paste secrets into chat.
# .env.local is ignored by Git; this example must contain no real secrets.

# Confirmed GitHub username. Create a separate OnePhone repository first.
# GITHUB_REPO is its name only (for example: onephone), not the full URL.
GITHUB_OWNER=iaqool
GITHUB_REPO=

# Optional. Prefer `gh auth login` (OS credential store) instead of a PAT here.
# If used after repository creation, grant access only to OnePhone and only the permissions needed.
GH_TOKEN=

# Optional private RPC endpoint for the read-only SGT checker and Torque exporter.
# Leave empty to use the CLI defaults. A provider URL may contain a secret.
SOLANA_RPC_URL=

# Public wallet address only; no seed phrase or private key.
SEEKER_PUBLIC_WALLET=

# Optional, only after creating a Torque account/project. Not used by the current local export.
TORQUE_API_TOKEN=

# Optional, only if a cloud Android build through Expo/EAS is chosen later.
EXPO_TOKEN=
