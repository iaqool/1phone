# Public values only. Expo embeds EXPO_PUBLIC_* into the APK.
# Leave the next two empty until the OnePhone program and namespace exist on mainnet.
EXPO_PUBLIC_ONEPHONE_PROGRAM_ID=
EXPO_PUBLIC_ONEPHONE_NAMESPACE=
# Optional public mainnet RPC endpoint. Never embed a private RPC token here.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
